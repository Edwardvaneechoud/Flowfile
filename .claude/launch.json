{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web", "--prefix", "flowfile_frontend"],
      "port": 8080
    },
    {
      "name": "wasm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "flowfile_wasm"],
      "port": 5174
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "site"],
      "port": 8765
    }
  ]
}
