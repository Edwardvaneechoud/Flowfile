{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "core",
      "runtimeExecutable": "poetry",
      "runtimeArgs": [
        "run",
        "flowfile_core"
      ],
      "port": 63578
    },
    {
      "name": "worker",
      "runtimeExecutable": "poetry",
      "runtimeArgs": [
        "run",
        "flowfile_worker"
      ],
      "port": 63579
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--prefix",
        "flowfile_frontend"
      ],
      "port": 8080
    },
    {
      "name": "wasm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "flowfile_wasm"
      ],
      "port": 5174
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "site"
      ],
      "port": 8765
    },
    {
      "name": "web-8081",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web",
        "--prefix",
        "flowfile_frontend",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "core-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "FLOWFILE_OFFLOAD_TO_WORKER=0 poetry run flowfile_core --port 63590"
      ],
      "port": 63590
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "FLOWFILE_CORE_PORT=63590 npm run dev:web --prefix flowfile_frontend -- --port 8082"
      ],
      "port": 8082
    }
  ]
}
