              {
                "field": "region",
                "aggregate": null,
                "channel": [
                  "color"
                ]
              }
            ]
          },
          "fallback_current": {
            "mark": "line",
            "x": {
              "field": "order_date",
              "timeUnit": "month"
            },
            "y": {
              "field": "revenue",
              "aggregate": "sum"
            }
          }
        },
        {
          "prompt": "only 2025",
          "expect": {
            "outcome": "chart",
            "marks": [
              "line"
            ],
            "fields": [
              {
                "field": "order_date",
                "timeUnit": "month"
              },
              {
                "field": "revenue",
                "aggregate": [
                  "sum"
                ]
              },
              {
                "field": "region",
                "aggregate": null,
                "channel": [
                  "color"
                ]
              }
            ],
            "filters": [
              {
                "field": "order_date",
                "include": [
                  "2025-01-01",
                  "2025-12-31"
