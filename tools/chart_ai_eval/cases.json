{
  "about": "Prompts for tools/chart_ai_eval, each with what a correct answer must contain (partial, never one exact chart; the vocabulary is in tools/chart_ai_eval/scoring.py). A follow_up case sends each step the chart the step before returned as current_chart, or fallback_current when that step returned none.",
  "cases": [
    {
      "id": "tidy-revenue-by-region",
      "table": "tidy",
      "kind": "single",
      "steps": [
        {
          "prompt": "revenue by region",
          "expect": {
            "outcome": "chart",
            "marks": [
              "bar"
            ],
            "fields": [
              {
                "field": "region",
                "aggregate": null
              },
              {
                "field": "revenue",
                "aggregate": [
                  "sum"
                ]
              }
            ]
          }
        }
      ]
    },
