          },
          "fallback_current": {
            "mark": "line",
            "x": {
              "field": "order_date",
              "timeUnit": "month"
            },
            "y": {
              "field": "revenue",
              "aggregate": "sum"
            },
            "color": {
              "field": "region"
            }
          }
        }
