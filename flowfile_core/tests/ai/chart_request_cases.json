      "verdict": "accepted",
      "request": { "mark": "bar", "x": { "field": "region" }, "y": { "field": "amount", "aggregate": "sum" } }
    },
    {
      "name": "top 3 bars",
      "verdict": "accepted",
      "request": {
        "mark": "bar",
        "x": { "field": "region" },
