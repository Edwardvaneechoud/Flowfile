{
  "about": "Chart requests with the verdict core's check_chart gives them against these columns, read by flowfile_core/tests/ai/test_chart_request_cases.py (core) and flowfile_frontend/src/renderer/app/views/CatalogView/chartRequestCases.test.ts (the browser's mirror, chartRequest.ts::coreRefusals). accepted: core takes the request exactly as written. rejected: core refuses it or rewrites it. Only rules the browser can judge from number, date or text are here: not integer against decimal, boolean values, hour on a date, column-name case or filter values of another type.",
  "columns": [
    { "name": "region", "type": "string" },
    { "name": "category", "type": "string" },
    { "name": "amount", "type": "float" },
    { "name": "quantity", "type": "integer" },
    { "name": "order_date", "type": "date" },
    { "name": "lat", "type": "float" },
    { "name": "lon", "type": "float" }
  ],
