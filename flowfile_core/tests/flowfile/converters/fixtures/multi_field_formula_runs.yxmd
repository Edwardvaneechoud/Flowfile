      <Properties><Configuration>
        <Fields>
          <Field name="name" />
          <Field name="city" />
          <Field name="jan" />
          <Field name="Total " />
        </Fields>
        <Data>
          <r><c>ann</c><c>rome</c><c>5</c><c>20</c></r>
          <r><c>bob</c><c>oslo</c><c>15</c><c>20</c></r>
