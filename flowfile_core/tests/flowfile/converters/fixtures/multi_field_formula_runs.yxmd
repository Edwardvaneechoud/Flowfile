      <Properties><Configuration>
        <FieldType>Numeric</FieldType>
        <Fields>
          <Field name="jan" />
          <Field name="*Unknown" />
          <Field name="Total " selected="False" />
        </Fields>
        <NewFieldAddOn><![CDATA[ % Total]]></NewFieldAddOn>
        <NewFieldAddOnPos>Suffix</NewFieldAddOnPos>
        <CopyOutput value="True" />
        <Expression>[_CurrentField_]/[Total ]*100</Expression>
        <ChangeFieldType value="True" />
        <OutputFieldType type="FixedDecimal" size="4" scale="1" />
      </Configuration></Properties>
    </Node>
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiFieldFormula.MultiFieldFormula">
