import polars as pl

from flowfile import node_designer as nd


class Settings(nd.NodeSettings):
    main = nd.Section(title="Auth", api_key=nd.SecretSelector(label="API key"))


def process(self, df: pl.LazyFrame) -> pl.LazyFrame:
    token = self.settings.main.api_key.secret_value
    return df.with_columns(authed=pl.lit(bool(token)))
