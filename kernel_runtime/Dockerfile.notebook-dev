# Dev-only notebook kernel: this checkout's flowfile wheel on the local lite image (`make notebook_kernel_dev`).
ARG BASE_IMAGE=flowfile-kernel-lite:local

# polars-grouper publishes no linux/aarch64 wheel, so build it where a Rust toolchain exists.
FROM python:3.12-slim AS wheels
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.cargo/bin:${PATH}"
RUN pip wheel --no-cache-dir --no-deps --prefer-binary "polars-grouper>=0.5.0" -w /wheels

FROM ${BASE_IMAGE}
COPY --from=wheels /wheels /tmp/wheels/
COPY flowfile-*.whl /tmp/wheels/
RUN pip install --no-cache-dir --find-links /tmp/wheels --constraint /opt/constraints.txt /tmp/wheels/flowfile-*.whl \
    && rm -rf /tmp/wheels
